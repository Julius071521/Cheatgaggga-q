<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>
<main id="main-content" class="container page">
  <div class="page-head"><h1>Security · <span class="grad-text">Threat Radar</span> 🛡️</h1></div>
  <%- include('../partials/admin-nav') %>

  <% if (underAttack) { %>
  <div class="attack-banner">
    <strong>🔴 WEBSITE UNDER ATTACK</strong>
    <span>Multiple attackers detected in a short window. Review the flagged IPs below and block them — or turn on auto-block.</span>
  </div>
  <% } %>

  <div class="ref-stats">
    <div class="card stat-tile"><span class="stat-label">Threat events (24h)</span><strong class="stat-value"><%= stat.events24 || 0 %></strong></div>
    <div class="card stat-tile"><span class="stat-label">Distinct IPs (24h)</span><strong class="stat-value"><%= stat.ips24 || 0 %></strong></div>
    <div class="card stat-tile"><span class="stat-label">Currently blocked</span><strong class="stat-value"><%= blockedCount %></strong></div>
  </div>

  <div class="card section-card">
    <div class="card-head"><h2>Controls</h2></div>
    <p class="muted">
      Threat Radar watches every request for scanners, injection attempts, bad bots and floods.
      <% if (telegramOn) { %>Alerts with one-tap <strong>Block/Allow</strong> buttons are sent to your Telegram.<% } else { %>
      <strong>Telegram is not configured yet</strong> — add <code>TELEGRAM_BOT_TOKEN</code> + <code>TELEGRAM_ADMIN_CHAT_ID</code> to get phone alerts.<% } %>
    </p>
    <div class="ticket-actions">
      <form method="post" action="/admin/security/toggle" class="inline-form"<% if (enabled) { %> data-confirm="Turn OFF Threat Radar? The site will stop detecting and blocking scanners/attackers."<% } %>>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="key" value="radar">
        <input type="hidden" name="value" value="<%= enabled ? '0' : '1' %>">
        <button type="submit" class="btn <%= enabled ? 'btn-danger' : 'btn-success' %>"><%= enabled ? '⏸ Turn OFF radar' : '▶️ Turn ON radar' %></button>
      </form>
      <form method="post" action="/admin/security/toggle" class="inline-form"<% if (autoBlock) { %> data-confirm="Turn OFF score-based auto-block? Clear attackers will still be instant-blocked, but borderline ones will only alert."<% } %>>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="key" value="auto">
        <input type="hidden" name="value" value="<%= autoBlock ? '0' : '1' %>">
        <button type="submit" class="btn <%= autoBlock ? 'btn-outline' : 'btn-primary' %>">
          <%= autoBlock ? '🤖 Auto-block: ON (turn off)' : '🤖 Enable auto-block' %>
        </button>
      </form>
    </div>
    <p class="muted" style="margin-top:8px"><small>Auto-block automatically bans clear-cut attackers (high score). You still get a notification with an Unblock button.</small></p>
    <p class="muted" style="margin-top:6px"><small>🛡️ <strong>Instant-block is ON:</strong> anyone probing for exploits (SQL injection, XSS, path traversal, scanner paths, hacking tools) is banned on their <em>first</em> attempt and shown a block page. Your own IP and signed-in admins are always exempt.</small></p>
  </div>

  <div class="card section-card">
    <div class="card-head"><h2>🔐 Account security</h2></div>

    <div class="kpi-grid kpi-grid-wide">
      <div class="kpi card"><span class="kpi-label">Admin actions (24h)</span><span class="kpi-value"><%= accounts.audit.actions24.toLocaleString() %></span></div>
      <div class="kpi card"><span class="kpi-label">Sign-ins (24h)</span><span class="kpi-value"><%= accounts.audit.logins24.toLocaleString() %></span></div>
      <div class="kpi card <%= accounts.audit.failed24 > 50 ? 'kpi-alert' : '' %>"><span class="kpi-label">Failed attempts (24h)</span><span class="kpi-value"><%= accounts.audit.failed24.toLocaleString() %></span></div>
      <div class="kpi card"><span class="kpi-label">Accounts locked now</span><span class="kpi-value"><%= accounts.locked.length %></span></div>
    </div>

    <h3 style="margin:18px 0 8px;font-size:1rem">Policies</h3>
    <div class="ticket-actions">
      <% [['require2fa', accounts.require2fa, '🔐 Require 2FA for admins',
            'Turn OFF the 2FA requirement for admin accounts? A single leaked password would then be enough to reach every customer balance.'],
          ['lockout', accounts.lockoutOn, '🔒 Per-account lockout',
            'Turn OFF per-account lockout? Password guessing spread across many IPs would no longer be stopped.'],
          ['fraud', accounts.fraudOn, '🕵️ Multi-account detection',
            'Turn OFF multi-account detection? Linked accounts will stop being recorded.']].forEach(function (p) { %>
        <form method="post" action="/admin/security/policy" class="inline-form"<% if (p[1]) { %> data-confirm="<%= p[3] %>"<% } %>>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="policy" value="<%= p[0] %>">
          <input type="hidden" name="value" value="<%= p[1] ? '0' : '1' %>">
          <button type="submit" class="btn btn-sm <%= p[1] ? 'btn-primary' : 'btn-outline' %>"><%= p[1] ? '✓ ' : '○ ' %><%= p[2] %></button>
        </form>
      <% }); %>
      <a href="/admin/audit" class="btn btn-sm btn-outline">🗂️ Open the audit trail</a>
    </div>

    <h3 style="margin:18px 0 8px;font-size:1rem">Admin accounts</h3>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Admin</th><th>Role</th><th>Two-factor</th></tr></thead>
        <tbody>
          <% accounts.admins.forEach(function (a) { %>
            <tr>
              <td><strong><%= a.username %></strong><br><small class="muted"><%= a.email %></small></td>
              <td><%= a.role %></td>
              <td>
                <% if (a.totp_enabled) { %><span class="badge badge-completed">ON</span>
                <% } else { %><span class="badge badge-failed">OFF — this account is one password away</span><% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (accounts.spread && accounts.spread.length) { %>
      <h3 style="margin:18px 0 8px;font-size:1rem">⚠️ One account, many addresses — this is a stuffing run</h3>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Account tried</th><th class="num">Distinct IPs</th><th class="num">Attempts</th></tr></thead>
          <tbody>
            <% accounts.spread.forEach(function (s) { %>
              <tr><td><code><%= s.username_tried %></code></td><td class="num"><%= s.ips %></td><td class="num"><%= s.tries %></td></tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <% if (accounts.locked.length) { %>
      <h3 style="margin:18px 0 8px;font-size:1rem">Locked accounts</h3>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Account</th><th class="num">Failures</th><th>Locked until</th><th></th></tr></thead>
          <tbody>
            <% accounts.locked.forEach(function (l) { %>
              <tr>
                <td><%= l.username %><br><small class="muted"><%= l.email %></small></td>
                <td class="num"><%= l.failed_logins %></td>
                <td><%= h.formatDate(l.locked_until) %></td>
                <td>
                  <form method="post" action="/admin/security/unlock" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="user_id" value="<%= l.id %>">
                    <button type="submit" class="btn btn-sm btn-outline">🔓 Unlock</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <h3 style="margin:18px 0 8px;font-size:1rem">🕵️ Accounts that look linked</h3>
    <% if (accounts.flagged.length) { %>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Account</th><th class="num">Risk</th><th>Signals</th><th class="num">Links</th><th class="num">Balance</th><th></th></tr></thead>
          <tbody>
            <% accounts.flagged.forEach(function (f) { %>
              <tr>
                <td><%= f.username %><br><small class="muted"><%= f.email %></small></td>
                <td class="num"><strong><%= f.fraud_score %></strong></td>
                <td><small class="muted"><%= f.fraud_flags || '—' %></small></td>
                <td class="num"><%= f.link_count %></td>
                <td class="num">₱<%= h.money(f.balance) %></td>
                <td><a href="/admin/fraud/<%= f.id %>" class="btn btn-sm btn-outline">View links</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <p class="muted" style="margin-top:8px"><small>A shared IP is weak evidence on its own — households, offices and mobile networks all share one.
        A shared <strong>payment receipt</strong> is strong. Open an account before acting on it.</small></p>
    <% } else { %>
      <p class="muted"><small>Nothing flagged yet. Accounts created before this shipped have no fingerprint — run a backfill to check them against each other.</small></p>
      <form method="post" action="/admin/fraud/backfill" class="inline-form" style="margin-top:8px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-sm btn-outline">Scan older accounts</button>
      </form>
    <% } %>
  </div>

  <div class="card section-card">
    <div class="card-head"><h2>🛰️ Network Guard — VPN · Proxy · Tor · VPS</h2></div>
    <p class="muted">
      Identifies visitors on a VPN, a proxy, a Tor exit node, or a rented server (VPS / datacenter) —
      the networks fraud and chargebacks come from. <strong><%= netguard.ranges %></strong> datacenter ranges are matched
      instantly with no lookup<% if (netguard.lookupOn) { %>, and anything else is checked against a live intelligence source<% } %>.
    </p>

    <div class="kpi-grid kpi-grid-wide">
      <div class="kpi card"><span class="kpi-label">Datacenter / VPS</span><span class="kpi-value"><%= netguard.stats.hosting.toLocaleString() %></span></div>
      <div class="kpi card"><span class="kpi-label">VPN</span><span class="kpi-value"><%= netguard.stats.vpn.toLocaleString() %></span></div>
      <div class="kpi card"><span class="kpi-label">Proxy</span><span class="kpi-value"><%= netguard.stats.proxy.toLocaleString() %></span></div>
      <div class="kpi card"><span class="kpi-label">Tor</span><span class="kpi-value"><%= netguard.stats.tor.toLocaleString() %></span></div>
      <div class="kpi card"><span class="kpi-label">Normal connections seen</span><span class="kpi-value"><%= netguard.stats.residential.toLocaleString() %></span></div>
      <div class="kpi card"><span class="kpi-label">Requests refused</span><span class="kpi-value"><%= netguard.stats.blockedHits.toLocaleString() %></span></div>
    </div>

    <h3 style="margin:18px 0 8px;font-size:1rem">Mode</h3>
    <div class="ticket-actions">
      <% const MODES = [
           ['off', 'Off', 'No detection at all.'],
           ['monitor', 'Monitor', 'Records everything, blocks nothing. Safest way to see who is actually on a VPN before you decide.'],
           ['guard', 'Guard', 'Browsing and login stay open; sign-up, deposit and placing an order are refused. Keeps real customers, stops the fraud paths.'],
           ['block', 'Block everything', 'The whole site is refused. Strictest — some genuine customers on a VPN will be turned away.'],
         ]; %>
      <% MODES.forEach(function (m) { const on = netguard.mode === m[0]; %>
        <form method="post" action="/admin/security/netguard" class="inline-form"<% if (m[0] === 'block' && !on) { %> data-confirm="Block the ENTIRE site for VPN/proxy/VPS visitors? Real customers who leave a VPN on will not be able to reach your site at all."<% } %>>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="mode" value="<%= m[0] %>">
          <button type="submit" class="btn <%= on ? 'btn-primary' : 'btn-outline' %>" title="<%= m[2] %>"<%= on ? ' aria-current="true"' : '' %>><%= on ? '● ' : '' %><%= m[1] %></button>
        </form>
      <% }); %>
    </div>
    <p class="muted" style="margin-top:8px"><small>
      <% const CUR = { off: 'Nothing is being detected.',
                       monitor: 'Recording only — nobody is being turned away.',
                       guard: 'Sign-up, deposit and order are protected. Browsing stays open.',
                       block: 'The whole site is closed to these networks.' }; %>
      <strong>Now:</strong> <%= CUR[netguard.mode] || netguard.mode %>
    </small></p>

    <h3 style="margin:18px 0 8px;font-size:1rem">What counts as blocked</h3>
    <div class="ticket-actions">
      <% [['hosting','🖥️ Datacenter / VPS'],['vpn','🛰️ VPN'],['proxy','🔀 Proxy'],['tor','🧅 Tor']].forEach(function (k) { const on = netguard[k[0]]; %>
        <form method="post" action="/admin/security/netguard" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="kind" value="<%= k[0] %>">
          <input type="hidden" name="value" value="<%= on ? '0' : '1' %>">
          <button type="submit" class="btn btn-sm <%= on ? 'btn-primary' : 'btn-outline' %>"><%= on ? '✓ ' : '○ ' %><%= k[1] %></button>
        </form>
      <% }); %>
    </div>
    <p class="muted" style="margin-top:8px"><small>
      🔑 Your reseller <strong>API is never filtered</strong> — a request with a valid API key is allowed from any network, because
      your API customers call it from their own servers. Signed-in admins and trusted IPs are also always allowed.
    </small></p>

    <% if (netguard.recent && netguard.recent.length) { %>
      <h3 style="margin:18px 0 8px;font-size:1rem">Recently seen on these networks</h3>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>IP</th><th>Type</th><th>Network</th><th class="num">Requests</th><th class="num">Refused</th><th>Last seen</th><th></th></tr></thead>
          <tbody>
            <% netguard.recent.forEach(function (r) { %>
              <tr>
                <td><code><%= r.ip %></code></td>
                <td><span class="badge"><%= r.label %></span></td>
                <td><%= r.org || '—' %><%= r.countryCode ? ` · ${r.countryCode}` : '' %></td>
                <td class="num"><%= r.hits %></td>
                <td class="num"><%= r.blockedHits %></td>
                <td><%= r.lastSeen ? new Date(r.lastSeen).toLocaleString('en-PH') : '—' %></td>
                <td>
                  <form method="post" action="/admin/security/netguard/clear" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="ip" value="<%= r.ip %>">
                    <button type="submit" class="btn btn-sm btn-outline" title="Treat as a normal connection from now on">✅ Let in</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="muted" style="margin-top:14px"><small>No VPN, proxy or datacenter visitors recorded yet.</small></p>
    <% } %>
  </div>

  <div class="card section-card">
    <div class="card-head"><h2>✅ Trusted IPs (never flagged or blocked)</h2></div>
    <p class="muted">Your own IP, office, or the VPS you manage from. Signed-in admins are already exempt automatically — this covers you even when logged out, and never lets your own IP look "suspicious".</p>
    <div class="trust-me">
      <span>Your current IP: <code><%= myIp %></code></span>
      <% var alreadyTrusted = allowed.some(function(a){ return a.ip === myIp; }); %>
      <% if (!alreadyTrusted) { %>
      <form method="post" action="/admin/security/ip" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="ip" value="<%= myIp %>">
        <input type="hidden" name="action" value="trust">
        <button type="submit" class="btn btn-primary btn-sm">✅ Trust this IP</button>
      </form>
      <% } else { %><span class="badge badge-completed">already trusted</span><% } %>
    </div>
    <form method="post" action="/admin/security/ip" class="inline-form" style="margin-top:12px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="action" value="trust">
      <input type="text" name="ip" class="input-sm" placeholder="Add another IP (e.g. your VPS)" maxlength="45" pattern="[0-9a-fA-F:.]{3,45}">
      <button type="submit" class="btn btn-outline btn-sm">Add trusted IP</button>
    </form>
    <% if (allowed.length) { %>
    <div class="table-wrap" style="margin-top:12px">
      <table class="table table-compact">
        <thead><tr><th>Trusted IP</th><th>Last seen</th><th></th></tr></thead>
        <tbody>
          <% allowed.forEach(function(a) { %>
          <tr>
            <td><code><%= a.ip %></code><%= a.ip === myIp ? ' (you)' : '' %></td>
            <td class="muted"><%= a.last_seen ? h.formatDate(a.last_seen) : '—' %></td>
            <td>
              <form method="post" action="/admin/security/ip" class="inline-form" data-confirm="Remove this trusted IP? It can be flagged/blocked again like any other IP.">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="ip" value="<%= a.ip %>">
                <input type="hidden" name="action" value="untrust">
                <button type="submit" class="btn btn-ghost btn-sm">Remove</button>
              </form>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>

  <div class="card section-card">
    <div class="card-head"><h2>☁️ Cloudflare edge</h2></div>
    <% if (cfConfigured) { %>
      <p class="muted">Connected ✅ — blocking an IP here also blocks it at the Cloudflare edge (before it reaches your server). <strong><%= cfEdgeBlocked %></strong> IP(s) currently blocked at the edge.</p>
      <% if (cfThreats.length) { %>
      <h3 class="mt">Recently blocked by Cloudflare (24h)</h3>
      <div class="table-wrap">
        <table class="table table-compact">
          <thead><tr><th>IP</th><th>Country</th><th>Path</th><th>Rule</th></tr></thead>
          <tbody>
            <% cfThreats.forEach(function(t) { %>
            <tr>
              <td><code><%= t.clientIP %></code></td>
              <td class="muted"><%= t.clientCountryName || '—' %></td>
              <td class="muted"><%= String(t.clientRequestPath || '').slice(0, 40) %></td>
              <td class="muted"><small><%= t.source || '' %></small></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } else { %><p class="empty-note">No edge blocks in the last 24h — quiet is good. 🟢</p><% } %>
    <% } else { %>
      <p class="muted">Not connected. Add <code>CLOUDFLARE_API_TOKEN</code> + <code>CLOUDFLARE_ZONE_ID</code> to block attackers at the Cloudflare edge and see what Cloudflare's firewall is stopping. Setup steps are in <code>CLOUDFLARE_SETUP.md</code>.</p>
    <% } %>
  </div>

  <div class="card section-card">
    <div class="card-head"><h2>🎯 Flagged IPs</h2></div>
    <% if (threats.length) { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>IP · Location</th><th>Danger</th><th class="num">Events</th><th>Last activity</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% threats.forEach(function(t) { var lvl = threatLevel(t.score); %>
          <tr>
            <td>
              <code><%= t.ip %></code>
              <% if (t.country) { %><br><small class="muted"><%= flagEmoji(t.country_code) %> <%= [t.city, t.country].filter(Boolean).join(', ') %><%= t.is_proxy ? ' · VPN' : '' %></small><% } %>
              <% if (t.isp) { %><br><small class="muted"><%= String(t.isp).slice(0, 30) %></small><% } %>
            </td>
            <td><span class="threat-pill threat-<%= lvl.label.toLowerCase() %>"><%= lvl.emoji %> <%= lvl.label %></span><br><small class="muted">score <%= t.score %></small></td>
            <td class="num"><%= t.events_count %></td>
            <td><span class="badge badge-tx-order"><%= (kindLabel[t.last_kind] || t.last_kind) %></span><br><small class="muted"><%= String(t.last_path || '').slice(0, 28) %></small></td>
            <td>
              <% if (t.is_blocked) { %><span class="badge badge-failed">blocked</span>
              <% } else if (t.status === 'watch') { %><span class="badge badge-pending">watching</span>
              <% } else { %><span class="badge badge-processing">flagged</span><% } %>
            </td>
            <td class="actions-cell">
              <% if (t.is_blocked) { %>
                <form method="post" action="/admin/security/ip" class="inline-form" data-confirm="Unblock <%= t.ip %>? It will be able to reach the site again."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="ip" value="<%= t.ip %>"><input type="hidden" name="action" value="allow"><button class="btn btn-ghost btn-sm">✅ Unblock</button></form>
              <% } else { %>
                <form method="post" action="/admin/security/ip" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="ip" value="<%= t.ip %>"><input type="hidden" name="action" value="block"><button class="btn btn-outline btn-sm">🚫 Block</button></form>
                <form method="post" action="/admin/security/ip" class="inline-form" data-confirm="Allow <%= t.ip %> and stop flagging it?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="ip" value="<%= t.ip %>"><input type="hidden" name="action" value="allow"><button class="btn btn-ghost btn-sm">✅ Allow</button></form>
              <% } %>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } else { %>
      <p class="empty-note">No threats flagged yet — the radar is watching. 🟢</p>
    <% } %>
  </div>

  <div class="card section-card">
    <div class="card-head"><h2>📜 Recent security events</h2></div>
    <% if (recent.length) { %>
    <div class="table-wrap">
      <table class="table table-compact">
        <thead><tr><th>When</th><th>IP</th><th>Type</th><th>Method</th><th>Path</th></tr></thead>
        <tbody>
          <% recent.forEach(function(ev) { %>
          <tr>
            <td class="muted"><%= h.formatDate(ev.created_at) %></td>
            <td><code><%= ev.ip %></code></td>
            <td><span class="badge badge-tx-order"><%= ev.kind %></span></td>
            <td class="muted"><%= ev.method %></td>
            <td class="muted"><%= String(ev.path || '').slice(0, 50) %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } else { %>
      <p class="empty-note">No events recorded yet.</p>
    <% } %>
  </div>
</main>
<%- include('../partials/footer') %>
