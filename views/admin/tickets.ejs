<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>
<main id="main-content" class="container page">
  <div class="page-head"><h1>Customer <span class="grad-text">concerns</span></h1></div>
  <%- include('../partials/admin-nav') %>

  <div class="dash-nav">
    <a href="/admin/tickets" class="pill <%= !status ? 'active' : '' %>">All</a>
    <% ['open','in_progress','resolved','closed'].forEach(function(s) { %>
      <a href="/admin/tickets?status=<%= s %>" class="pill <%= status === s ? 'active' : '' %>"><%= h.statusLabel(s.replace('_',' ')) %></a>
    <% }); %>
  </div>

  <div class="filter-bar card">
    <form class="filter-search" method="get" action="/admin/tickets">
      <% if (status) { %><input type="hidden" name="status" value="<%= status %>"><% } %>
      <input type="search" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="Search: APX-… code, provider order #, customer, subject" maxlength="80">
      <button type="submit" class="btn btn-primary btn-sm">Search</button>
      <% if (typeof q !== 'undefined' && q) { %><a href="/admin/tickets<%= status ? ('?status=' + status) : '' %>" class="btn btn-ghost btn-sm">Clear</a><% } %>
    </form>
  </div>

  <% if (tickets.length) { %>
  <div class="tickets-list">
    <% tickets.forEach(function(t) { %>
    <div class="card ticket-card">
      <div class="ticket-head">
        <div>
          <strong>#<%= t.id %> · <%= t.subject || 'Concern' %></strong>
          <% if (t.request_type) { %><span class="badge badge-tx-order"><%= t.request_type %></span><% } %>
          <span class="badge badge-<%= h.statusSlug(t.status || 'open') %>"><%= h.statusLabel(t.status || 'open') %></span>
          <% if (t.staff_unread) { %><span class="badge badge-pending">new reply</span><% } %>
          <a href="/admin/tickets/<%= t.id %>/thread" class="btn btn-outline btn-sm">💬 Open chat</a>
        </div>
        <span class="muted"><%= h.formatDate(t.created_at) %></span>
      </div>
      <p class="ticket-meta muted">
        From <strong><%= t.username || t.email || ('user #' + t.user_id) %></strong>
        <% if (t.order_id) { %> · order <code><%= t.order_id %></code><% } %>
        <% if (t.provider_order_id) { %> · provider #<%= t.provider_order_id %><% } %>
      </p>
      <% if (t.message) { %><p class="ticket-msg"><%= String(t.message).slice(0, 400) %></p><% } %>
      <% if (t.provider_action_status) { %>
        <p class="muted"><small>Last action: <strong><%= t.provider_action_status %></strong><% if (t.provider_refill_id) { %> · refill #<%= t.provider_refill_id %><% } %> — <%= String(t.provider_action_response || '').slice(0,120) %></small></p>
      <% } %>

      <% /* What has already been done, so the team can see it at a glance
            instead of guessing from a single "last action" line. */ %>
      <% if (t.doneActions && t.doneActions.length) { %>
        <p class="ticket-done muted"><small>
          <% var DONE_LABEL = { refill: '♻️ Refill sent', speedup: '⚡ Speed-up requested', cancel: '✖ Cancel sent', refund: '💸 Refunded' }; %>
          Already done: <% t.doneActions.forEach(function (d, i) { %><strong><%= DONE_LABEL[d] || d %></strong><%= i < t.doneActions.length - 1 ? ' · ' : '' %><% }); %>
        </small></p>
      <% } %>

      <div class="ticket-actions">
        <% var rt = String(t.request_type || '').toLowerCase();
           var LABEL = {
             refill:  { label: '♻️ Refill',   hot: rt.indexOf('refill') > -1 },
             speedup: { label: '⚡ Speed up',  hot: rt.indexOf('speed') > -1 },
             cancel:  { label: '✖ Cancel',    hot: rt.indexOf('cancel') > -1 },
           };
           /* Only the actions that still apply — one that has been done, or that
              the order's state rules out, is not rendered at all. */
           (t.availableActions || []).filter(function (a) { return a !== 'refund'; }).forEach(function (a) {
             var b = LABEL[a]; %>
        <form method="post" action="/admin/tickets/<%= t.id %>/action" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="action" value="<%= a %>">
          <button type="submit" class="btn btn-sm <%= b.hot ? 'btn-primary' : 'btn-outline' %>"><%= b.label %></button>
        </form>
        <% }); %>
        <% if ((t.availableActions || []).indexOf('refund') > -1) { %>
        <form method="post" action="/admin/tickets/<%= t.id %>/action" class="inline-form"
              data-confirm="Refund this order to the customer’s wallet? This cannot be undone." data-confirm-type="refund">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="action" value="refund">
          <button type="submit" class="btn btn-sm <%= (rt.indexOf('stuck') > -1 || rt.indexOf('not complet') > -1 || rt.indexOf('refund') > -1) ? 'btn-danger' : 'btn-ghost' %>">💸 Refund</button>
        </form>
        <% } %>
        <% if (t.closedReason) { %>
          <span class="badge badge-completed"><%= t.closedReason === 'refunded' ? 'Refunded — nothing left to do' : 'Handled' %></span>
        <% } %>
        <form method="post" action="/admin/tickets/<%= t.id %>/status" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <select name="status" class="input-sm">
            <% ['open','in_progress','resolved','closed'].forEach(function(s) { %>
              <option value="<%= s %>" <%= (t.status||'open')===s ? 'selected':'' %>><%= h.statusLabel(s.replace('_',' ')) %></option>
            <% }); %>
          </select>
          <button type="submit" class="btn btn-ghost btn-sm">Update</button>
        </form>
      </div>
    </div>
    <% }); %>
  </div>
  <% } else { %>
    <p class="empty-note">No customer concerns<%= status ? ' with status "' + status + '"' : '' %> right now. 🎉</p>
  <% } %>
</main>
<%- include('../partials/footer') %>
