<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>
<main class="container page">
  <div class="page-head">
    <h1>Ticket <span class="grad-text">#<%= ticket.id %></span></h1>
    <a href="/admin/tickets" class="btn btn-ghost btn-sm">← All concerns</a>
  </div>
  <%- include('../partials/admin-nav') %>

  <div class="card section-card">
    <p class="muted" style="margin:0">
      <strong><%= ticket.subject || 'Concern' %></strong>
      <% if (ticket.request_type) { %><span class="badge badge-tx-order"><%= ticket.request_type %></span><% } %>
      <span class="badge badge-<%= h.statusSlug(ticket.status || 'open') %>"><%= h.statusLabel(ticket.status || 'open') %></span>
      · From <strong><%= customer.username || customer.email || ('user #' + ticket.user_id) %></strong>
      <% if (ticket.order_id) { %> · order <code><%= ticket.order_id %></code><% } %>
      <% if (ticket.provider_order_id) { %> · provider #<%= ticket.provider_order_id %><% } %>
    </p>
  </div>

  <div class="chat-thread">
    <% messages.forEach(function(m) { var staff = m.sender === 'staff'; %>
      <div class="chat-row <%= staff ? 'chat-mine' : 'chat-theirs' %>">
        <div class="chat-bubble">
          <div class="chat-who"><%= staff ? 'You (staff)' : (m.sender === 'system' ? '🤖 Autopilot' : (customer.username || 'Customer')) %></div>
          <div class="chat-body"><%= m.body %></div>
          <div class="chat-time"><%= h.formatDate(m.created_at) %></div>
        </div>
      </div>
    <% }); %>
  </div>

  <form method="post" action="/admin/tickets/<%= ticket.id %>/reply" class="card chat-compose">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <textarea name="message" rows="3" maxlength="4000" required placeholder="Reply to the customer…"></textarea>
    <div class="chat-compose-side">
      <select name="status" class="input-sm">
        <option value="in_progress">Mark: In progress</option>
        <option value="resolved">Mark: Resolved</option>
        <option value="open">Mark: Open</option>
        <option value="closed">Mark: Closed</option>
      </select>
      <button type="submit" class="btn btn-primary">Send reply</button>
    </div>
  </form>
</main>

<style>
  .chat-thread { display:flex; flex-direction:column; gap:10px; margin:14px 0; }
  .chat-row { display:flex; }
  .chat-mine { justify-content:flex-end; }
  .chat-theirs { justify-content:flex-start; }
  .chat-bubble { max-width:min(78%, 560px); padding:10px 14px; border-radius:14px; box-shadow:var(--shadow); }
  .chat-mine .chat-bubble { background:var(--grad-btn); color:#fff; border-bottom-right-radius:4px; }
  .chat-theirs .chat-bubble { background:var(--surface); border:1px solid var(--border); border-bottom-left-radius:4px; }
  .chat-who { font-size:.72rem; font-weight:700; opacity:.75; margin-bottom:2px; }
  .chat-body { white-space:pre-wrap; word-break:break-word; line-height:1.45; }
  .chat-time { font-size:.68rem; opacity:.6; margin-top:4px; }
  .chat-compose { display:flex; gap:10px; align-items:flex-end; padding:12px; flex-wrap:wrap; }
  .chat-compose textarea { flex:1; min-width:240px; resize:vertical; }
  .chat-compose-side { display:flex; flex-direction:column; gap:8px; }
</style>
<%- include('../partials/footer') %>
