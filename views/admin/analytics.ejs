<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>
<main class="container page">
  <div class="page-head"><h1>Business <span class="grad-text">analytics</span> 📊</h1></div>
  <%- include('../partials/admin-nav') %>

  <div class="ref-stats">
    <div class="card stat-tile"><span class="stat-label">Revenue this month</span><strong class="stat-value">₱<%= h.money(now.revenue) %></strong></div>
    <div class="card stat-tile"><span class="stat-label">Profit this month</span><strong class="stat-value">₱<%= h.money(now.profit) %></strong></div>
    <div class="card stat-tile"><span class="stat-label">Orders this month</span><strong class="stat-value"><%= now.orders %></strong></div>
    <div class="card stat-tile"><span class="stat-label">New members</span><strong class="stat-value"><%= now.new_users %></strong></div>
  </div>

  <div class="card section-card">
    <div class="card-head"><h2>Revenue vs profit — last 12 months</h2></div>
    <div class="chart-legend">
      <span><i class="dot" style="background:#2563eb"></i> Revenue</span>
      <span><i class="dot" style="background:#10b981"></i> Profit</span>
    </div>
    <div id="chart-monthly" class="chart-box" aria-label="Monthly revenue and profit line chart"
         data-monthly='<%= JSON.stringify(monthly.map(function(m){ return { l: m.ym, r: Number(m.revenue), p: Number(m.profit) }; })) %>'></div>
  </div>

  <div class="card section-card">
    <div class="card-head"><h2>Daily revenue — last 30 days</h2></div>
    <div id="chart-daily" class="chart-box" aria-label="Daily revenue bar chart"
         data-daily='<%= JSON.stringify(daily.map(function(d){ return { l: String(d.d).slice(0, 10), r: Number(d.revenue) }; })) %>'></div>
  </div>

  <div class="an-grid">
    <div class="card section-card">
      <div class="card-head"><h2>Top services by profit (30d)</h2></div>
      <% if (topServices.length) { var maxP = Math.max.apply(null, topServices.map(function(s){ return Number(s.profit); })) || 1; %>
      <div class="hbars">
        <% topServices.forEach(function(s) { %>
        <div class="hbar-row">
          <span class="hbar-label" title="<%= s.service_name %>"><%= s.service_name.length > 34 ? s.service_name.slice(0,34) + '…' : s.service_name %></span>
          <span class="hbar-track"><i class="hbar-fill" style="width:<%= Math.max(2, Math.round(Number(s.profit) / maxP * 100)) %>%"></i></span>
          <span class="hbar-val">₱<%= h.money(s.profit) %> <small class="muted">(<%= s.orders %>)</small></span>
        </div>
        <% }); %>
      </div>
      <% } else { %><p class="empty-note">No orders in the last 30 days.</p><% } %>
    </div>

    <div class="card section-card">
      <div class="card-head"><h2>Deposits by method (30d)</h2></div>
      <% if (byMethod.length) { var maxM = Math.max.apply(null, byMethod.map(function(m){ return Number(m.total); })) || 1; %>
      <div class="hbars">
        <% byMethod.forEach(function(m) { %>
        <div class="hbar-row">
          <span class="hbar-label"><%= String(m.payment_method || 'other').toUpperCase() %></span>
          <span class="hbar-track"><i class="hbar-fill hbar-fill-alt" style="width:<%= Math.max(2, Math.round(Number(m.total) / maxM * 100)) %>%"></i></span>
          <span class="hbar-val">₱<%= h.money(m.total) %> <small class="muted">(<%= m.cnt %>)</small></span>
        </div>
        <% }); %>
      </div>
      <% } else { %><p class="empty-note">No approved deposits in the last 30 days.</p><% } %>
    </div>
  </div>

  <div class="card section-card">
    <div class="card-head"><h2>Top customers (30d)</h2></div>
    <% if (topCustomers.length) { %>
    <div class="table-wrap">
      <table class="table table-compact">
        <thead><tr><th>Customer</th><th class="num">Orders</th><th class="num">Spend</th><th class="num">Profit</th></tr></thead>
        <tbody>
          <% topCustomers.forEach(function(c) { %>
          <tr>
            <td><strong><%= c.username || c.email %></strong></td>
            <td class="num"><%= c.orders %></td>
            <td class="num">₱<%= h.money(c.spend) %></td>
            <td class="num">₱<%= h.money(c.profit) %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } else { %><p class="empty-note">No customer activity in the last 30 days.</p><% } %>
  </div>
</main>

<style>
  .chart-legend { display:flex; gap:18px; margin:0 0 6px 2px; font-size:.85rem; color:var(--text-soft); }
  .chart-legend .dot { display:inline-block; width:10px; height:10px; border-radius:3px; margin-right:6px; vertical-align:-1px; }
  .chart-box { position:relative; width:100%; }
  .chart-box svg { display:block; width:100%; height:auto; }
  .chart-tip { position:absolute; pointer-events:none; background:var(--surface); border:1px solid var(--border);
    border-radius:8px; padding:6px 10px; font-size:.8rem; box-shadow:var(--shadow); white-space:nowrap; z-index:5; display:none; }
  .an-grid { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
  @media (max-width: 900px) { .an-grid { grid-template-columns:1fr; } }
  .hbars { display:flex; flex-direction:column; gap:8px; }
  .hbar-row { display:grid; grid-template-columns: minmax(120px, 240px) 1fr auto; gap:10px; align-items:center; font-size:.85rem; }
  .hbar-label { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .hbar-track { background:var(--surface-2); border-radius:6px; height:14px; overflow:hidden; }
  .hbar-fill { display:block; height:100%; background:#2563eb; border-radius:0 4px 4px 0; }
  .hbar-fill-alt { background:#10b981; }
  .hbar-val { text-align:right; font-variant-numeric:tabular-nums; }
</style>

<script src="/assets/js/admin-analytics.js?v=<%= assetVersion %>" defer></script>
<%- include('../partials/footer') %>
