<%- include('partials/head', { title: 'Under maintenance' }) %>
<main id="main-content" class="container page-error">
  <div style="font-size:3.5rem;margin-bottom:10px">🛠️</div>
  <h1 class="err-code" style="font-size:clamp(2rem,6vw,3.2rem)">Under maintenance</h1>
  <p><%= site.name %> is getting an upgrade and will be back shortly. Thanks for your patience!</p>
  <% if (site.supportEmail) { %><p class="muted">Questions? <a href="mailto:<%= site.supportEmail %>"><%= site.supportEmail %></a></p><% } %>
  <a href="/login" class="btn btn-outline">Admin sign in</a>
</main>
<%- include('partials/footer') %>
