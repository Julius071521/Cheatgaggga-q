<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>
<main class="container page">
  <div class="page-head"><h1>Account <span class="grad-text">settings</span></h1></div>
  <%- include('../partials/dash-nav') %>

  <div class="settings-grid">
    <div class="card" data-reveal>
      <h2>Profile</h2>
      <p class="muted">Signed in as <strong><%= user.email %></strong><% if (user.google_id) { %> · linked to Google<% } %></p>
      <form method="post" action="/settings/profile">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="field">
          <span>Display name</span>
          <input type="text" name="name" value="<%= user.name %>" maxlength="100">
        </label>
        <button type="submit" class="btn btn-primary">Save profile</button>
      </form>
    </div>

    <div class="card" data-reveal data-reveal-delay="80">
      <h2>Password</h2>
      <form method="post" action="/settings/password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (user.has_password) { %>
        <label class="field">
          <span>Current password</span>
          <input type="password" name="current_password" autocomplete="current-password">
        </label>
        <% } else { %>
          <p class="muted">You signed up with Google — set a password to also sign in with email.</p>
        <% } %>
        <label class="field">
          <span>New password <small>(min. 8 characters)</small></span>
          <input type="password" name="new_password" required minlength="8" autocomplete="new-password">
        </label>
        <button type="submit" class="btn btn-primary"><%= user.has_password ? 'Change password' : 'Set password' %></button>
      </form>
    </div>

    <div class="card twofa-card <%= twofaEnabled ? 'twofa-on' : '' %>" id="twofa" data-reveal data-reveal-delay="160">
      <h2>🔐 Two-factor authentication <%= twofaEnabled ? '— ON' : '' %></h2>
      <% if (twofaEnabled) { %>
        <p class="muted">Your account is protected. You'll be asked for a code from your authenticator app at each login.</p>
        <form method="post" action="/settings/2fa/disable" data-confirm="Turn off two-factor protection?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="field">
            <span>Enter a current code to turn it off</span>
            <input type="text" name="code" required inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="123456">
          </label>
          <button type="submit" class="btn btn-danger">Turn off 2FA</button>
        </form>
      <% } else if (pending2fa) { %>
        <p class="muted">Add this account to <strong>Google Authenticator</strong>, Authy, or Microsoft Authenticator, then enter the code it shows to finish.</p>
        <div class="twofa-key">
          <span class="muted">Setup key (tap Copy, then "Enter a setup key" in your app):</span>
          <div class="pm-row">
            <code class="api-key"><%= pending2fa.secret.match(/.{1,4}/g).join(' ') %></code>
            <button type="button" class="btn btn-ghost btn-sm copy-btn" data-copy="<%= pending2fa.secret %>">Copy</button>
          </div>
          <p class="auth-fineprint" style="text-align:left">Account name: <strong><%= site.name %> (<%= user.email %>)</strong> · Type: Time-based</p>
        </div>
        <form method="post" action="/settings/2fa/enable">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="field">
            <span>Enter the 6-digit code from your app</span>
            <input type="text" name="code" required inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="123456" autofocus>
          </label>
          <button type="submit" class="btn btn-primary">Confirm &amp; enable</button>
          <button type="submit" formaction="/settings/2fa/cancel" formnovalidate class="btn btn-ghost">Cancel</button>
        </form>
      <% } else { %>
        <p class="muted">Add a second layer of security. After your password, login will also require a 6-digit code from your phone — so a stolen password isn't enough. <strong>Strongly recommended for admins.</strong></p>
        <form method="post" action="/settings/2fa/start">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-primary">Enable two-factor</button>
        </form>
      <% } %>
    </div>

    <div class="card" data-reveal data-reveal-delay="240">
      <h2>Reseller API</h2>
      <p class="muted">Use our standard SMM panel API to resell services from your own site. Endpoint: <code>POST /api/v2</code> with <code>key</code> + <code>action</code> (<code>services</code>, <code>add</code>, <code>status</code>, <code>balance</code>). Prices are in PHP.</p>
      <% if (user.api_key) { %>
        <div class="pm-row">
          <code class="api-key" id="api-key" data-full="<%= user.api_key %>" data-masked="<%= user.api_key.slice(0,4) + '••••••••••••••••••••••••' + user.api_key.slice(-4) %>"><%= user.api_key.slice(0,4) %>••••••••••••••••••••••••<%= user.api_key.slice(-4) %></code>
          <button type="button" class="btn btn-ghost btn-sm" id="api-key-toggle">Show</button>
          <button type="button" class="btn btn-ghost btn-sm copy-btn" data-copy="<%= user.api_key %>">Copy</button>
        </div>
        <p class="auth-fineprint" style="text-align:left">Keep this key secret — anyone with it can place orders on your balance.</p>
      <% } else { %>
        <p class="empty-note">No API key yet.</p>
      <% } %>
      <form method="post" action="/settings/api-key" class="mt-sm"<% if (user.api_key) { %> data-confirm="Regenerate your API key? Your current key stops working immediately and any integration using it must be updated."<% } %>>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-outline"><%= user.api_key ? 'Regenerate key' : 'Generate API key' %></button>
      </form>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
