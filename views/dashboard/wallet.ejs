<%- include('../partials/head', { title }) %>
<%- include('../partials/app-shell') %>
<main id="main-content" class="app-page">
  <div class="page-head">
    <h1>Wallet & <span class="grad-text">add funds</span></h1>
    <p>Current balance: <strong class="price">₱<%= h.money(user.balance) %></strong></p>
  </div>

  <div class="wallet-layout">
    <div class="card" data-reveal>
      <h2>1️⃣ Send your payment</h2>
      <% if (bonusTiers.length) { %>
      <div class="bonus-banner">
        <strong>🎁 Deposit bonus — bigger top-up, bigger bonus!</strong>
        <div class="bonus-tiers">
          <% bonusTiers.forEach(function(t) { %>
            <span class="bonus-tier">₱<%= t.min.toLocaleString() %>+ <em>→ +<%= t.pct %>%</em></span>
          <% }); %>
        </div>
        <small class="muted">The bonus is added automatically the moment your deposit is approved.</small>
      </div>
      <% } %>
      <p class="muted">Transfer any amount (min. ₱50) to one of our accounts:</p>
      <% if (methods.length) { %>
      <div class="pay-methods">
        <% methods.forEach(function(m) { %>
        <div class="pay-method pay-<%= m.code %>">
          <div class="pm-head"><strong><%= m.label %></strong><% if (m.extra) { %><small><%= m.extra %></small><% } %></div>
          <div class="pm-row">
            <span class="pm-number" id="pm-<%= m.code %>"><%= m.number %></span>
            <button type="button" class="btn btn-ghost btn-sm copy-btn" data-copy="<%= m.number %>">Copy</button>
          </div>
          <small class="muted">Account name: <%= m.name %></small>
        </div>
        <% }); %>
      </div>
      <% } else { %>
        <p class="empty-note">Payment channels are being set up. Please contact support to add funds.</p>
      <% } %>

      <h2 class="mt">2️⃣ Submit the details</h2>
      <form method="post" action="/wallet/deposit" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="field">
          <span>Payment method</span>
          <select name="method" required>
            <option value="">— Choose —</option>
            <% methods.forEach(function(m) { %><option value="<%= m.code %>"><%= m.label %></option><% }); %>
          </select>
        </label>
        <label class="field">
          <span>Amount sent (₱)</span>
          <input type="number" name="amount" min="50" max="1000000" step="0.01" required placeholder="500.00">
        </label>
        <% if (bonusTiers.length) { %>
        <div class="qty-chips" id="dep-chips">
          <% bonusTiers.forEach(function(t) { %>
            <button type="button" class="qty-chip" data-amount="<%= t.min %>">₱<%= t.min.toLocaleString() %> <em>+<%= t.pct %>%</em></button>
          <% }); %>
        </div>
        <% } %>
        <p class="dep-preview" id="dep-preview" hidden data-tiers="<%= bonusTiers.map(function(t){ return t.min + ':' + t.pct; }).join(',') %>"></p>
        <label class="field">
          <span>Reference number</span>
          <input type="text" name="reference" required minlength="4" maxlength="100" placeholder="e.g. 1234 5678 9012">
        </label>
        <label class="field">
          <span>Receipt screenshot <small>(optional, JPG/PNG/WEBP, max 5MB)</small></span>
          <input type="file" name="receipt" accept="image/jpeg,image/png,image/webp">
        </label>
        <button type="submit" class="btn btn-primary btn-lg btn-block">Submit deposit</button>
        <p class="auth-fineprint">Deposits are verified by our team — usually within minutes to a few hours. You'll get an email once it's credited.</p>
      </form>
    </div>

    <div class="wallet-side">
      <div class="card" data-reveal data-reveal-delay="100">
        <h2>Recent deposits</h2>
        <% if (deposits.length) { %>
        <div class="table-wrap">
          <table class="table table-compact">
            <thead><tr><th>Method</th><th class="num">Amount</th><th>Ref</th><th>Status</th><th>Date</th></tr></thead>
            <tbody>
              <% deposits.forEach(function(d) { %>
              <tr>
                <td><%= String(d.payment_method).toUpperCase() %></td>
                <td class="num">₱<%= h.money(d.amount) %><% if (d.bonus_amount && Number(d.bonus_amount) > 0) { %><br><small class="pos">+₱<%= h.money(d.bonus_amount) %> 🎁</small><% } %></td>
                <td class="muted"><%= String(d.reference_id).slice(0, 14) %></td>
                <td><span class="badge badge-<%= h.statusSlug(d.status) %>"><%= h.statusLabel(d.status) %></span>
                  <% if (String(d.status).toLowerCase() === 'rejected' && d.admin_note) { %><br><small class="muted"><%= d.admin_note %></small><% } %></td>
                <td class="muted"><%= h.formatDate(d.created_at) %></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } else { %><p class="empty-note">No deposits yet.</p><% } %>
      </div>

      <div class="card" data-reveal data-reveal-delay="180">
        <h2>Transaction history</h2>
        <% if (transactions.length) { %>
        <div class="table-wrap">
          <table class="table table-compact">
            <thead><tr><th>Type</th><th class="num">Amount</th><th class="num">Balance</th><th>Date</th></tr></thead>
            <tbody>
              <% transactions.forEach(function(t) { %>
              <tr>
                <td><span class="badge badge-tx-<%= t.type %>"><%= t.type %></span><% if (t.description) { %><br><small class="muted"><%= t.description.slice(0, 40) %></small><% } %></td>
                <td class="num <%= Number(t.amount) >= 0 ? 'pos' : 'neg' %>"><%= Number(t.amount) >= 0 ? '+' : '' %>₱<%= h.money(t.amount) %></td>
                <td class="num">₱<%= h.money(t.new_balance) %></td>
                <td class="muted"><%= h.formatDate(t.created_at) %></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } else { %><p class="empty-note">Nothing here yet.</p><% } %>
      </div>
    </div>
  </div>
</main>
<script src="/assets/js/wallet.js?v=<%= assetVersion %>" defer></script>
<%- include('../partials/app-foot') %>
