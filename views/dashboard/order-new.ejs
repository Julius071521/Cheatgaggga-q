<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>
<main class="container page">
  <div class="page-head"><h1>Place a <span class="grad-text">new order</span></h1></div>
  <%- include('../partials/dash-nav') %>

  <div class="order-layout">
    <form class="card order-form" method="post" action="/order/new" id="order-form"
          data-preselected='<%- preselected ? JSON.stringify({ id: preselected.id, platform: preselected.platform }) : "null" %>'>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="field">
        <span>Platform</span>
        <div class="plat-grid" id="plat-grid" role="group" aria-label="Choose a platform">
          <% platforms.forEach(function(p) { %>
          <button type="button" class="plat-btn <%= preselected && preselected.platform === p ? 'active' : '' %>" data-platform="<%= p %>">
            <%- include('../partials/platform-badge', { platform: p, size: 30 }) %>
            <span><%= h.platformLabel(p) %></span>
          </button>
          <% }); %>
        </div>
        <input type="hidden" id="of-platform" value="<%= preselected ? preselected.platform : '' %>">
      </div>

      <div class="field">
        <span>Service</span>
        <div class="svc-picker" id="svc-picker">
          <button type="button" class="svc-trigger" id="svc-trigger" disabled aria-haspopup="listbox" aria-expanded="false">
            <span class="svc-trigger-label" id="svc-trigger-label"><span class="muted">— Choose a platform first —</span></span>
            <svg class="svc-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="svc-panel" id="svc-panel" hidden>
            <div class="svc-search">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.3-3.3"/></svg>
              <input type="search" id="svc-search" placeholder="Search services… (e.g. followers, likes)" autocomplete="off">
            </div>
            <div class="svc-list" id="svc-list" role="listbox" tabindex="-1"></div>
          </div>
          <input type="hidden" name="service_id" id="of-service">
        </div>
      </div>

      <!-- Platform icons the picker clones for each service row -->
      <div id="pb-icons" hidden>
        <% platforms.forEach(function(p) { %><span data-pb="<%= p %>"><%- include('../partials/platform-badge', { platform: p, size: 26 }) %></span><% }); %>
      </div>

      <div class="of-meta" id="of-meta" hidden>
        <span id="of-rate"></span>
        <span id="of-range"></span>
        <span id="of-refill"></span>
      </div>

      <!-- Assistant guidance that appears once a service is chosen -->
      <div class="of-guidance" id="of-guidance" hidden>
        <div class="ofg-head"><span class="ofg-avatar">🤖</span> <strong><%= site.name %> Assistant</strong></div>
        <ul>
          <li>💡 <strong>Try a small test order first</strong> (<span id="ofg-testqty">near the minimum</span>) before ordering in bulk — this confirms the service works for your link.</li>
          <li>⏳ <strong>Delivery time varies by service.</strong> Many start within minutes, but some can take <strong>5 days up to 1 month</strong> depending on the provider.</li>
          <li>🛟 Occasionally an order can get <strong>stuck</strong> and take a while to fix even after you file a report — we appreciate your patience, and failed/partial orders are auto-refunded.</li>
        </ul>
      </div>

      <label class="field">
        <span>Link <small>(profile / post / video URL)</small></span>
        <input type="url" name="link" id="of-link" required maxlength="500" placeholder="https://instagram.com/yourprofile" value="<%= typeof prefillLink !== 'undefined' ? prefillLink : '' %>">
      </label>
      <p class="link-warn" id="of-linkwarn" hidden>⚠️ This link doesn't look like a <strong id="of-linkwarn-plat"></strong> link — please double-check it before ordering.</p>

      <label class="field">
        <span>Quantity</span>
        <input type="number" name="quantity" id="of-qty" required min="1" step="1" placeholder="1000" value="<%= typeof prefillQty !== 'undefined' ? prefillQty : '' %>">
      </label>
      <div class="qty-chips" id="qty-chips" hidden></div>

      <!-- Drip-feed: appears only for services that support it -->
      <div class="dripfeed-box" id="dripfeed-box" hidden>
        <label class="drip-toggle">
          <input type="checkbox" name="dripfeed" id="of-drip" value="on">
          <span>💧 <strong>Drip-feed</strong> — deliver gradually (more natural, safer for the account)</span>
        </label>
        <div class="drip-fields" id="drip-fields" hidden>
          <label class="field">
            <span>Runs <small>(how many batches, 2–100)</small></span>
            <input type="number" name="runs" id="of-runs" min="2" max="100" step="1" placeholder="10">
          </label>
          <label class="field">
            <span>Interval <small>(minutes between batches, 1–1440)</small></span>
            <input type="number" name="interval" id="of-interval" min="1" max="1440" step="1" placeholder="60">
          </label>
          <p class="muted drip-note" id="of-drip-note"></p>
        </div>
      </div>

      <label class="field">
        <span>Promo code <small>(optional)</small></span>
        <input type="text" name="promo_code" maxlength="50" placeholder="Enter a coupon code" autocomplete="off" style="text-transform:uppercase">
      </label>

      <div class="of-total">
        <span>Total charge <small class="muted">(before promo)</small></span>
        <strong id="of-total">₱0.00</strong>
      </div>

      <button type="submit" class="btn btn-primary btn-lg btn-block" id="of-submit" disabled>Place order</button>
      <p class="auth-fineprint">Your balance: <strong>₱<%= h.money(user.balance) %></strong> · <a href="/wallet">add funds</a></p>
    </form>

    <!-- Confirmation modal -->
    <div class="modal-overlay" id="of-confirm" hidden>
      <div class="modal-card card">
        <h3>Confirm your order</h3>
        <div class="confirm-lines">
          <div><span>Service</span><strong id="cf-service">—</strong></div>
          <div><span>Quantity</span><strong id="cf-qty">—</strong></div>
          <div><span>Total charge</span><strong id="cf-total" class="price">—</strong></div>
        </div>
        <p class="confirm-warn">⏳ Delivery time depends on the service — many start within minutes, but some can take <strong>5 days up to 1 month</strong>, and an order may occasionally get stuck even after a report. Failed/partial orders are auto-refunded.</p>
        <div class="confirm-actions">
          <button type="button" class="btn btn-ghost" id="cf-cancel">Cancel</button>
          <button type="button" class="btn btn-primary" id="cf-confirm">Yes, place order ✅</button>
        </div>
      </div>
    </div>

    <aside class="order-tips card">
      <h3>💡 Quick tips</h3>
      <ul>
        <li>Make sure your account/post is <strong>public</strong> before ordering.</li>
        <li>Don't order twice on the same link while an order is still running.</li>
        <li>Failed orders are <strong>auto-refunded</strong> to your wallet in full.</li>
        <li>Partial deliveries refund the undelivered portion automatically.</li>
      </ul>
    </aside>
  </div>
</main>
<script src="/assets/js/order-form.js?v=<%= assetVersion %>" defer></script>
<%- include('../partials/footer') %>
