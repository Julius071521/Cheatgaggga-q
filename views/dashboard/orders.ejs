<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>
<main id="main-content" class="container page">
  <div class="page-head"><h1>My <span class="grad-text">orders</span></h1></div>
  <%- include('../partials/dash-nav') %>

  <div class="filter-bar card">
    <form class="filter-search" method="get" action="/orders">
      <input type="search" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="Search order code, service, or link…" maxlength="80">
      <select name="status" class="input-sm">
        <option value="">All statuses</option>
        <% ['Pending','In progress','Processing','Completed','Partial','Canceled','Failed'].forEach(function(s){ %>
          <option value="<%= s %>" <%= (typeof status !== 'undefined' && status === s) ? 'selected' : '' %>><%= s %></option>
        <% }); %>
      </select>
      <button type="submit" class="btn btn-primary btn-sm">Search</button>
      <% if ((typeof q !== 'undefined' && q) || (typeof status !== 'undefined' && status)) { %><a href="/orders" class="btn btn-ghost btn-sm">Clear</a><% } %>
    </form>
  </div>

  <% if (orders.length) { %>
  <div class="table-wrap card" data-reveal>
    <table class="table">
      <thead><tr><th>ID</th><th>Service</th><th>Link</th><th class="num">Qty</th><th class="num">Charge</th><th class="num">Start</th><th class="num">Remains</th><th>Status</th><th>Date</th><th></th></tr></thead>
      <tbody>
        <% orders.forEach(function(o) { %>
        <tr>
          <td class="muted" title="<%= o.order_id %>">#<%= o.id %></td>
          <td><div class="svc-cell"><%- include('../partials/platform-badge', { platform: h.platformFromText(o.service_name), size: 26 }) %><span class="svc-name"><%= o.service_name.length > 45 ? o.service_name.slice(0,45) + '…' : o.service_name %></span></div></td>
          <td><a href="<%= o.url %>" target="_blank" rel="noopener nofollow" class="link-cell"><%= String(o.url).replace(/^https?:\/\//,'').slice(0, 28) %>…</a></td>
          <td class="num"><%= Number(o.quantity).toLocaleString() %></td>
          <td class="num">₱<%= h.money(o.charge) %><% if (Number(o.refund_amount) > 0) { %><br><small class="refund">↩ ₱<%= h.money(o.refund_amount) %></small><% } %></td>
          <td class="num"><%= o.start_count == null ? '—' : Number(o.start_count).toLocaleString() %></td>
          <td class="num">
            <% var qty = Number(o.quantity) || 0;
               var rem = o.remains == null ? null : Number(o.remains);
               var pct = null;
               if (o.status === 'Completed') pct = 100;
               else if (rem != null && qty > 0) pct = Math.max(0, Math.min(100, Math.round((qty - rem) / qty * 100)));
               if (pct == null) { %>—<% } else { %>
              <div class="oprog" title="<%= pct %>% delivered">
                <span class="oprog-fill" style="width:<%= pct %>%"></span>
              </div>
              <small class="muted"><%= pct %>%</small>
            <% } %>
          </td>
          <td>
            <span class="badge badge-<%= h.statusSlug(o.status) %>"><%= h.statusLabel(o.status) %></span>
            <% var tk = (typeof ticketByOrder !== 'undefined' && ticketByOrder[o.order_id]) || null;
               if (tk) {
                 var pas = String(tk.provider_action_status || '');
                 var chip = null;
                 if (pas === 'refill_sent') chip = ['♻️ Refill in progress', 'badge-processing'];
                 else if (pas === 'refill_completed') chip = ['♻️ Refill done ✅', 'badge-completed'];
                 else if (pas === 'refill_rejected') chip = ['♻️ Refill under review', 'badge-pending'];
                 else if (pas === 'cancel_sent') chip = ['✖ Cancel requested', 'badge-pending'];
                 else if (['open','in_progress'].includes(String(tk.status || '').toLowerCase())) chip = ['📨 Report received', 'badge-pending'];
                 if (chip) { %><br><span class="badge <%= chip[1] %>" style="margin-top:4px"><small><%= chip[0] %></small></span><% }
               } %>
          </td>
          <td class="muted"><%= h.formatDate(o.created_at) %></td>
          <td class="actions-cell">
            <% if (['Pending','In progress','Processing'].includes(o.status)) { %>
            <form method="post" action="/orders/<%= o.id %>/refresh" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-ghost btn-sm" title="Refresh status">⟳</button>
            </form>
            <% } %>
            <% if (o.local_service_id) { %>
            <a class="btn btn-outline btn-sm" title="Order this again with the same link & quantity"
               href="/order/new?service=<%= o.local_service_id %>&link=<%= encodeURIComponent(o.url) %>&qty=<%= o.quantity %>">🔁 Reorder</a>
            <% } %>
            <button type="button" class="btn btn-ghost btn-sm" data-report
                    data-order-id="<%= o.id %>" data-order-code="<%= o.order_id %>">Report</button>
            <% if (o.status === 'Completed' && typeof reviewed !== 'undefined' && !reviewed.has(o.id)) { %>
            <button type="button" class="btn btn-outline btn-sm" data-review
                    data-order-id="<%= o.id %>" data-order-code="<%= o.order_id %>">★ Review</button>
            <% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/pagination', { pagination, basePath: '/orders', query: {} }) %>
  <% } else { %>
    <p class="empty-note" data-reveal>No orders yet — <a href="/order/new">place your first order</a>! 🚀</p>
  <% } %>
</main>

<!-- One shared report dialog at body level — a top-layer <dialog> is never
     affected by the horizontally-scrolling table, so it works on mobile. -->
<dialog id="report-sheet" class="report-dialog">
  <form method="post" id="report-form" class="report-dialog-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="report-dialog-head">
      <strong>Report a concern</strong>
      <span class="muted" id="report-order-label"></span>
    </div>
    <label>What's the issue?
      <select name="request_type" class="input-sm">
        <option>Refill</option><option>Cancel</option><option>Speed up</option><option>Other</option>
      </select>
    </label>
    <textarea name="message" required minlength="3" maxlength="2000" rows="3" placeholder="Describe your concern…"></textarea>
    <div class="report-dialog-actions">
      <button type="button" class="btn btn-ghost btn-sm" data-report-close>Cancel</button>
      <button type="submit" class="btn btn-primary btn-sm">Submit concern</button>
    </div>
  </form>
</dialog>

<dialog id="review-sheet" class="report-dialog">
  <form method="post" id="review-form" class="report-dialog-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="report-dialog-head">
      <strong>Rate your order</strong>
      <span class="muted" id="review-order-label"></span>
    </div>
    <div class="star-pick" id="star-pick" role="radiogroup" aria-label="Star rating">
      <% for (var st = 1; st <= 5; st++) { %>
      <label class="star-opt"><input type="radio" name="rating" value="<%= st %>" required> <span>★</span></label>
      <% } %>
    </div>
    <textarea name="body" rows="3" maxlength="600" placeholder="Tell others how it went (optional)…"></textarea>
    <div class="report-dialog-actions">
      <button type="button" class="btn btn-ghost btn-sm" data-review-close>Cancel</button>
      <button type="submit" class="btn btn-primary btn-sm">Post review</button>
    </div>
  </form>
</dialog>
<%- include('../partials/footer') %>
