<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>
<main class="container page">
  <div class="page-head"><h1>My <span class="grad-text">orders</span></h1></div>
  <%- include('../partials/dash-nav') %>

  <% if (orders.length) { %>
  <div class="table-wrap card" data-reveal>
    <table class="table">
      <thead><tr><th>ID</th><th>Service</th><th>Link</th><th class="num">Qty</th><th class="num">Charge</th><th class="num">Start</th><th class="num">Remains</th><th>Status</th><th>Date</th><th></th></tr></thead>
      <tbody>
        <% orders.forEach(function(o) { %>
        <tr>
          <td class="muted" title="<%= o.order_id %>">#<%= o.id %></td>
          <td><div class="svc-cell"><%- include('../partials/platform-badge', { platform: h.platformFromText(o.service_name), size: 26 }) %><span class="svc-name"><%= o.service_name.length > 45 ? o.service_name.slice(0,45) + '…' : o.service_name %></span></div></td>
          <td><a href="<%= o.url %>" target="_blank" rel="noopener nofollow" class="link-cell"><%= String(o.url).replace(/^https?:\/\//,'').slice(0, 28) %>…</a></td>
          <td class="num"><%= Number(o.quantity).toLocaleString() %></td>
          <td class="num">₱<%= h.money(o.charge) %><% if (Number(o.refund_amount) > 0) { %><br><small class="refund">↩ ₱<%= h.money(o.refund_amount) %></small><% } %></td>
          <td class="num"><%= o.start_count == null ? '—' : Number(o.start_count).toLocaleString() %></td>
          <td class="num"><%= o.remains == null ? '—' : Number(o.remains).toLocaleString() %></td>
          <td><span class="badge badge-<%= h.statusSlug(o.status) %>"><%= h.statusLabel(o.status) %></span></td>
          <td class="muted"><%= h.formatDate(o.created_at) %></td>
          <td class="actions-cell">
            <% if (['Pending','In progress','Processing'].includes(o.status)) { %>
            <form method="post" action="/orders/<%= o.id %>/refresh" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-ghost btn-sm" title="Refresh status">⟳</button>
            </form>
            <% } %>
            <% if (o.local_service_id) { %>
            <a class="btn btn-ghost btn-sm" title="Order this again"
               href="/order/new?service=<%= o.local_service_id %>&link=<%= encodeURIComponent(o.url) %>">🔁</a>
            <% } %>
            <details class="report-details">
              <summary class="btn btn-ghost btn-sm">Report</summary>
              <form method="post" action="/orders/<%= o.id %>/ticket" class="report-form card">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <select name="request_type" class="input-sm">
                  <option>Refill</option><option>Cancel</option><option>Speed up</option><option>Other</option>
                </select>
                <textarea name="message" required minlength="3" maxlength="2000" rows="2" placeholder="Describe your concern…"></textarea>
                <button type="submit" class="btn btn-primary btn-sm">Submit concern</button>
              </form>
            </details>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/pagination', { pagination, basePath: '/orders', query: {} }) %>
  <% } else { %>
    <p class="empty-note" data-reveal>No orders yet — <a href="/order/new">place your first order</a>! 🚀</p>
  <% } %>
</main>
<%- include('../partials/footer') %>
