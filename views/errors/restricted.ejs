<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Unable to load site</title>
  <style>
    /* Deliberately plain and self-contained: this page has to render even when
       the rest of the site's CSS never loads. It is also NOT the attacker page
       — someone here is most likely a real customer who left a VPN on, so the
       tone stays neutral and tells them exactly what to do. */
    :root { color-scheme: dark; }
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
      background: #3a3a44; color: #ececf1; padding: 24px; text-align: center;
      font-family: 'Segoe UI', system-ui, -apple-system, 'Helvetica Neue', sans-serif;
    }
    .box { max-width: 560px; }
    .mark { color: #c5c5d2; opacity: 0.9; }
    h1 {
      display: flex; align-items: center; justify-content: center; gap: 10px;
      font-size: 22px; font-weight: 500; margin: 26px 0 0;
    }
    h1 svg { flex: none; color: #ef4146; }
    p { color: #b4b4c4; line-height: 1.55; margin: 14px 0 0; font-size: 14px; }
    .meta { margin-top: 22px; font-size: 12.5px; color: #8e8ea0; }
    a { color: #b4b4c4; }
    @media (max-width: 480px) { h1 { font-size: 19px; } }
  </style>
</head>
<body>
  <main id="main-content" class="box">
    <svg class="mark" width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 2 3 7v5c0 5 3.8 8.7 9 10 5.2-1.3 9-5 9-10V7l-9-5z"/>
    </svg>

    <h1>
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2 3 7v5c0 5 3.8 8.7 9 10 5.2-1.3 9-5 9-10V7l-9-5z"/><path d="M12 8v4"/><path d="M12 16h.01"/>
      </svg>
      Unable to load site
    </h1>

    <p>
      Please try again later.
      <% if (typeof reason !== 'undefined' && reason) { %>
        This connection was identified as <strong><%= reason %></strong> —
      <% } %>
      if you are using a VPN or proxy, please turn it off and reload.
    </p>
    <p>
      Mobile data or home Wi-Fi works best.
      <% if (typeof site !== 'undefined' && site.supportEmail) { %>
        If you believe this is a mistake, email <a href="mailto:<%= site.supportEmail %>"><%= site.supportEmail %></a> and quote the reference below.
      <% } %>
    </p>

    <div class="meta">
      [IP: <%= typeof clientIp !== 'undefined' && clientIp ? clientIp : 'unknown' %>
      <% if (typeof reference !== 'undefined' && reference) { %> | Ref: <%= reference %><% } %>]
    </div>
  </main>
</body>
</html>
