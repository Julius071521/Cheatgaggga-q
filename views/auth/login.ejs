<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>
<main class="auth-wrap">
  <div class="auth-card card" data-reveal>
    <h1>Welcome back 👋</h1>
    <p class="auth-sub">Sign in to manage your orders and wallet.</p>

    <% if (site.googleEnabled) { %>
      <a href="/auth/google" class="btn btn-google btn-block">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.9-.1-1.5-.3-2.2H12v4.1h6.5c-.1 1.1-.8 2.7-2.4 3.8l-.02.15 3.5 2.7.24.03c2.2-2.1 3.5-5.1 3.5-8.6z"/><path fill="#34A853" d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.8-2.9c-1 .7-2.4 1.2-4.1 1.2a7.2 7.2 0 0 1-6.8-5l-.14.01-3.7 2.8-.05.13A12 12 0 0 0 12 24z"/><path fill="#FBBC05" d="M5.2 14.4a7.4 7.4 0 0 1 0-4.7l-.01-.16-3.7-2.9-.12.06a12 12 0 0 0 0 10.7l3.8-3z"/><path fill="#EB4335" d="M12 4.6c2.3 0 3.8 1 4.7 1.8l3.4-3.3C18 1.2 15.2 0 12 0A12 12 0 0 0 1.3 6.7l3.8 3A7.2 7.2 0 0 1 12 4.6z"/></svg>
        Continue with Google
      </a>
      <div class="divider"><span>or use your email</span></div>
    <% } %>

    <form method="post" action="/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field">
        <span>Username or email</span>
        <input type="text" name="usernameOrEmail" required maxlength="190" autocomplete="username" placeholder="username or you@example.com">
      </label>
      <label class="field">
        <span>Password</span>
        <input type="password" name="password" required minlength="8" autocomplete="current-password" placeholder="••••••••">
      </label>
      <% if (site.turnstileSiteKey) { %><div class="cf-turnstile" data-sitekey="<%= site.turnstileSiteKey %>"></div><% } %>
      <button type="submit" class="btn btn-primary btn-block btn-lg">Sign in</button>
    </form>
    <p class="auth-links"><a href="/forgot">Forgot password?</a> · New here? <a href="/register">Create an account</a></p>
  </div>
</main>
<% if (site.turnstileSiteKey) { %><script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script><% } %>
<%- include('../partials/footer') %>
