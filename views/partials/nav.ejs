<header class="nav" id="site-nav">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label="<%= site.name %> home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 3 13h6l-1 9 10-12h-6l1-8z" fill="currentColor" stroke="none"/></svg>
      </span>
      <span class="brand-text"><%= site.name %></span>
    </a>

    <nav class="nav-links" id="nav-links" aria-label="Main">
      <a href="/#how-it-works" class="nav-link">How it works</a>
      <a href="/services" class="nav-link <%= path.startsWith('/services') ? 'active' : '' %>">Services</a>
      <a href="/#faq" class="nav-link">FAQ</a>
      <% if (user) { %>
        <a href="/dashboard" class="nav-link <%= path.startsWith('/dashboard') ? 'active' : '' %>">Dashboard</a>
        <% if (user.isAdmin) { %><a href="/admin" class="nav-link <%= path.startsWith('/admin') ? 'active' : '' %>">Admin</a><% } %>
      <% } %>
    </nav>

    <div class="nav-actions">
      <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle dark mode">
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <% if (user) { %>
        <span class="nav-balance" title="Wallet balance">₱<%= h.money(user.balance) %></span>
        <form method="post" action="/logout" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-ghost btn-sm">Sign out</button>
        </form>
      <% } else { %>
        <a href="/login" class="btn btn-ghost btn-sm">Sign in</a>
        <a href="/register" class="btn btn-primary btn-sm">Sign up free</a>
      <% } %>
      <button class="icon-btn nav-burger" id="nav-burger" type="button" aria-label="Menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>
<%- include('flash') %>
