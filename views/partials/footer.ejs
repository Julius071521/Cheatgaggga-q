<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="brand">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20"><path d="M12 2 3 13h6l-1 9 10-12h-6l1-8z" fill="currentColor"/></svg>
        </span>
        <span class="brand-text"><%= site.name %></span>
      </a>
      <p class="footer-tag">Grow your social media the easy way — affordable boosting services with instant, automated delivery.</p>
      <div class="pay-badges" aria-label="Accepted payments">
        <span class="pay-badge pay-gcash">GCash</span>
        <span class="pay-badge pay-maya">Maya</span>
        <span class="pay-badge pay-bpi">BPI</span>
      </div>
    </div>
    <div class="footer-col">
      <h4>Explore</h4>
      <a href="/services">Services & pricing</a>
      <a href="/#how-it-works">How it works</a>
      <a href="/#faq">FAQ</a>
      <a href="/terms">Terms of service</a>
      <a href="/terms#privacy">Privacy policy</a>
      <a href="/api-docs">API for resellers</a>
    </div>
    <div class="footer-col">
      <h4>Account</h4>
      <% if (user) { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/order/new">Place an order</a>
        <a href="/wallet">Add funds</a>
      <% } else { %>
        <a href="/register">Create account</a>
        <a href="/login">Sign in</a>
      <% } %>
      <% if (site.supportEmail) { %><a href="mailto:<%= site.supportEmail %>"><%= site.supportEmail %></a><% } %>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© <%= site.year %> <%= site.name %> · <%= site.domain %></span>
    <span class="footer-disclaimer">We are not affiliated with any social media platform. Use our services responsibly.</span>
  </div>
</footer>

<% if (site.aiEnabled) { %>
<div class="chat-widget" id="chat-widget">
  <button class="chat-fab" id="chat-fab" type="button" aria-label="Chat with support" aria-expanded="false">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-8 8H5l-2 2V12a8 8 0 0 1 8-8h2a8 8 0 0 1 8 8z"/><path d="M8 11h.01M12 11h.01M16 11h.01"/></svg>
  </button>
  <div class="chat-panel" id="chat-panel" hidden>
    <div class="chat-head">
      <div>
        <strong><%= site.name %> Assistant</strong>
        <span class="chat-status"><span class="dot"></span> Online</span>
      </div>
      <button class="icon-btn" id="chat-close" type="button" aria-label="Close chat">&times;</button>
    </div>
    <div class="chat-body" id="chat-body">
      <div class="chat-msg bot">Hi! 👋 I'm the <%= site.name %> assistant. Ask me anything about services, pricing, or payments — or tap a quick option below if you have an order concern.</div>
      <div class="chat-quick" id="chat-quick">
        <button type="button" class="chat-chip" data-report="Refill">♻️ Refill my order</button>
        <button type="button" class="chat-chip" data-report="Not completed">⚠️ Order not completed</button>
        <button type="button" class="chat-chip" data-report="Stuck">🐢 Order still stuck</button>
        <button type="button" class="chat-chip" data-report="Speed up">⚡ Speed up</button>
        <button type="button" class="chat-chip" data-report="Cancel">✖ Cancel order</button>
      </div>
    </div>
    <form class="chat-input" id="chat-form">
      <input type="text" id="chat-text" maxlength="1000" placeholder="Type your question…" autocomplete="off" required>
      <button type="submit" class="btn btn-primary btn-sm" aria-label="Send">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/></svg>
      </button>
    </form>
  </div>
</div>
<meta name="csrf-token" content="<%= csrfToken %>">
<script src="/assets/js/chat.js?v=<%= assetVersion %>" defer></script>
<% } %>

<script src="/assets/js/main.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
