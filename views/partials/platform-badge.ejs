<%
// Small colored platform badge. Usage: include('partials/platform-badge', { platform: 'instagram', size: 40 })
const s = typeof size !== 'undefined' ? size : 36;
const P = {
  instagram: { bg: 'linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888)', glyph: 'ig' },
  tiktok:    { bg: 'linear-gradient(135deg,#010101,#2b2b2b)', glyph: 'note' },
  facebook:  { bg: 'linear-gradient(135deg,#1877f2,#0f5ec7)', glyph: 'f' },
  youtube:   { bg: 'linear-gradient(135deg,#ff0000,#c4302b)', glyph: 'play' },
  twitter:   { bg: 'linear-gradient(135deg,#0f1419,#31353b)', glyph: 'X' },
  telegram:  { bg: 'linear-gradient(135deg,#2aabee,#229ed9)', glyph: 'plane' },
  spotify:   { bg: 'linear-gradient(135deg,#1db954,#169c46)', glyph: 'S' },
  snapchat:  { bg: 'linear-gradient(135deg,#fffc00,#f5e402)', glyph: 'S', dark: true },
  twitch:    { bg: 'linear-gradient(135deg,#9146ff,#6c2bd9)', glyph: 'T' },
  discord:   { bg: 'linear-gradient(135deg,#5865f2,#404eed)', glyph: 'D' },
  linkedin:  { bg: 'linear-gradient(135deg,#0a66c2,#084d92)', glyph: 'in' },
  website:   { bg: 'linear-gradient(135deg,#0ea5e9,#2563eb)', glyph: 'globe' },
  other:     { bg: 'linear-gradient(135deg,#64748b,#475569)', glyph: 'spark' },
};
const cfg = P[platform] || P.other;
%>
<span class="pbadge" style="--pb-size:<%= s %>px;background:<%= cfg.bg %>;color:<%= cfg.dark ? '#111827' : '#ffffff' %>" aria-hidden="true">
  <% if (cfg.glyph === 'ig') { %>
    <svg viewBox="0 0 24 24" width="55%" height="55%" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.15" fill="currentColor" stroke="none"/></svg>
  <% } else if (cfg.glyph === 'play') { %>
    <svg viewBox="0 0 24 24" width="60%" height="60%" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg>
  <% } else if (cfg.glyph === 'plane') { %>
    <svg viewBox="0 0 24 24" width="55%" height="55%" fill="currentColor"><path d="M22 2 2 10.4l5.6 2.2L20 5 9.6 14l.5 6L13 16.6l4.4 3.2z"/></svg>
  <% } else if (cfg.glyph === 'globe') { %>
    <svg viewBox="0 0 24 24" width="58%" height="58%" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
  <% } else if (cfg.glyph === 'note') { %>
    <svg viewBox="0 0 24 24" width="55%" height="55%" fill="currentColor"><path d="M14 3v10.6a3.5 3.5 0 1 1-2-3.2V3zM14 3c.4 2.8 2.2 4.6 5 5v3c-2 -.2-3.8-1-5-2.2"/></svg>
  <% } else if (cfg.glyph === 'spark') { %>
    <svg viewBox="0 0 24 24" width="55%" height="55%" fill="currentColor"><path d="M12 2l2.2 6.8L21 11l-6.8 2.2L12 20l-2.2-6.8L3 11l6.8-2.2z"/></svg>
  <% } else { %>
    <span class="pbadge-text"><%= cfg.glyph %></span>
  <% } %>
</span>
