# ── Site ──
SITE_NAME=ApexBoost
SITE_DOMAIN=apexsmmboosting.com
BASE_URL=https://apexsmmboosting.com
PORT=3000
NODE_ENV=production

# ── AI Assistant (OpenAI-compatible router) ──
AI_API_KEY=sk-your-router-api-key
AI_MODEL=gpt-5.5
AI_BASE_URL=https://agentrouter.org/v1
# If the router rejects the model id above, change AI_MODEL only (no code edit needed),
# e.g. gpt-5, gpt-4.1, or gpt-4o.

# ── AI Autopilot (auto-handles reports + watches stuck orders) ──
# The runtime ON/OFF switch lives in the admin panel (/admin/autopilot);
# these only control the background scheduler itself.
AUTOPILOT_ENABLED=true
AUTOPILOT_INTERVAL_MINUTES=10
AUTOPILOT_STUCK_HOURS=48
# Auto-approve small deposits with a receipt up to this amount (0 = off).
AUTO_APPROVE_DEPOSITS_MAX_PHP=500
# Hour of day (0-23, server time) to email the admin daily digest.
DAILY_DIGEST_HOUR=8

# ── Growth: deposit bonuses + referrals ──
# "minAmount:bonusPercent" pairs — e.g. deposit ₱1000 → +10% bonus funds.
DEPOSIT_BONUS_TIERS=500:5,1000:10,5000:50
# Commission the referrer earns on every approved top-up of an invited user.
REFERRAL_COMMISSION_PERCENT=5
# Minimum referral-earnings withdrawal request.
MIN_PAYOUT_PHP=100

# ── Telegram security bot (attacker alerts + one-tap block/allow) ──
# Make a NEW bot with @BotFather (/newbot), paste its token here. Then message
# the bot once and get your chat id from @userinfobot. Keep the webhook secret
# long and random (e.g. `openssl rand -hex 24`). Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Threat Radar tuning (defaults are sensible — adjust only if needed).
SECURITY_ALERT_SCORE=40
SECURITY_AUTOBLOCK_SCORE=120
SECURITY_ALERT_COOLDOWN_MIN=30
SECURITY_404_THRESHOLD=15
SECURITY_FLOOD_THRESHOLD=150

# ── Cloudflare edge blocking (optional but recommended — see CLOUDFLARE_SETUP.md) ──
# Lets the site block attackers at the Cloudflare edge and read what CF's WAF
# stops. Create a scoped API token (Zone.Firewall Services:Edit + Analytics:Read).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── Upstream SMM providers (standard SMM Panel API v2) ──
RKD_API_KEY=your-rkd-api-key
RKD_API_URL=https://rkdpanel.com/api/v2

SMMWORLD_API_KEY=your-smmworld-api-key
SMMWORLD_API_URL=https://smmworld.org/api/v2
# Optional import filters (comma-separated). Empty = import everything.
SMMWORLD_IMPORT_SERVICE_IDS=
SMMWORLD_IMPORT_KEYWORDS=

# ── Pricing ──
SERVICE_MARKUP_MULTIPLIER=2.50
USD_TO_PHP_RATE=60.2898
MIN_ORDER_CHARGE_PHP=0.01
SITE_CURRENCY=PHP
SITE_CURRENCY_SYMBOL=₱
# Optional provider low-balance guardrails (0 = disabled)
PROVIDER_LOW_BALANCE_THRESHOLD_PHP=0
PROVIDER_BLOCK_ORDERS_BELOW_THRESHOLD=false

# ── MySQL ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# ── SMTP email ──
EMAIL_HOST=mail.example.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_TLS_SERVERNAME=example.com
EMAIL_USER=admin@example.com
EMAIL_PASS=your-email-password
EMAIL_FROM_NAME=ApexBoost Support
EMAIL_FROM=admin@example.com
SUPPORT_EMAIL=admin@example.com

# ── Manual payment accounts (shown on the Add Funds page) ──
GCASH_ACCOUNT_NUMBER=09XXXXXXXXX
GCASH_ACCOUNT_NAME=Your Name
MAYA_ACCOUNT_NUMBER=09XXXXXXXXX
MAYA_ACCOUNT_NAME=Your Name
BPI_ACCOUNT_NUMBER=XXXXXXXXXX
BPI_ACCOUNT_NAME=Your Name
BPI_ACCOUNT_TYPE=Savings

# ── Auth / security ──
JWT_SECRET=generate-64-hex-chars
SESSION_SECRET=generate-64-hex-chars
EMAIL_VERIFICATION_REQUIRED=true

# Cloudflare Turnstile (both keys required; get the site key from the Cloudflare dashboard)
TURNSTILE_REQUIRED=true
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ── Google OAuth ──
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=https://apexsmmboosting.com/auth/google/callback

# ── Uploads (optional; defaults to ./uploads/receipts) ──
UPLOAD_DIR=
